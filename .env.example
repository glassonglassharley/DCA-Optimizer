# Supabase — required for cross-device sync of the ticker watchlist.
# Without these, /api/sync returns 503 and the app runs in local-only mode
# (the red "Not syncing" banner appears and data lives in localStorage).
#
# Copy to .env.local for local dev. On Vercel, add these under
# Project Settings → Environment Variables for Production AND Preview.
#
# Find both values in the Supabase dashboard: Project Settings → Data API.
# The anon key is safe to expose; never put the service_role key here.
#
# Do NOT add a NEXT_PUBLIC_ prefix. These are read only in /api routes
# (lib/supabaseSync.js, server-side). A NEXT_PUBLIC_-prefixed name would leave
# process.env.SUPABASE_URL undefined and /api/sync would return 503.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
