# ─── Clerk (authentication) ──────────────────────────────────────────────────
# Clerk dashboard → your application → API Keys.
# The publishable key MUST have the NEXT_PUBLIC_ prefix (the browser reads it).
# The secret key MUST NOT — it is server-only and grants full account access.
#
# Note: the build fails outright without the publishable key, because
# ClerkProvider throws during prerender. Set it before `npm run build`.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me


# ─── Supabase (data) ─────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → Data API.
# No NEXT_PUBLIC_ prefix on any of these — they are read only in /api routes.

SUPABASE_URL=https://your-project-ref.supabase.co

# service_role bypasses RLS and is the key the portfolio tables use. Server-only.
# Leaking this is equivalent to handing over the whole database.
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# LEGACY — only used by the old /api/sync endpoint, which the claim flow replaces.
# Keep it set until you have imported your data, then remove it along with
# pages/api/sync.js, api/sync.js and lib/supabaseSync.js.
SUPABASE_ANON_KEY=your-public-anon-key


# ─── Plaid (EXPERIMENTAL — sandbox only) ─────────────────────────────────────
# Plaid dashboard → Team Settings → Keys. Use the SANDBOX keys, not production.
# Server-only: no NEXT_PUBLIC_ prefix. The browser never sees these — it only
# receives a short-lived link_token minted by /api/plaid/link-token.
#
# PLAID_ENV must be the literal string "sandbox". The integration refuses to
# start in any other environment, by design.
#
# Nothing from this feature is persisted: the access_token is exchanged in
# memory inside one request and discarded, and holdings are returned to the
# browser for display only. There is no Plaid table and no migration.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
